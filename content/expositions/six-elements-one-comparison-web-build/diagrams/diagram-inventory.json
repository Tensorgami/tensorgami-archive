    {
      "number": 3,
      "file": "01-concrete-route.tex",
      "line": 94,
      "raw_tex": "\\begin{tikzcd}[column sep=large,row sep=small]\n G\\arrow[r,\"h\"]\\arrow[d,\"q_A\"']&H\\\\\n G/A\\arrow[ur,dashed,\"\\bar h\"']&\n \\end{tikzcd}",
