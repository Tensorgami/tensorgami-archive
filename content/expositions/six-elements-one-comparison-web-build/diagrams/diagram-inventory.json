    {
      "number": 4,
      "file": "01-concrete-route.tex",
      "line": 221,
      "raw_tex": "\\begin{tikzcd}[row sep=large,column sep=large]\n &M\\arrow[dl,two heads,\"a\"']\\arrow[dr,two heads,\"b'\"]&\\\\\n B\\arrow[d,\"\\id_B\"']&&G\\arrow[d,\"q_A\"]\\\\\n B\\arrow[rr,\"\\beta\"']&&G/A .\n\\end{tikzcd}",
