      "file": "01-concrete-route.tex",
      "line": 72,
      "raw_tex": "\\begin{tikzcd}[column sep=large,row sep=small]\n G\\arrow[r,\"\\tau_c\"]\\arrow[d,\"h\"']&G\\arrow[d,\"h\"]\\\\\n G\\arrow[r,\"\\tau_{h(c)}\"']&G .\n \\end{tikzcd}",
